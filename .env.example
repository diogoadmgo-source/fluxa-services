# Supabase (fluxa-dev)
SUPABASE_URL=https://lfufwoirpwlsdmststbr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # Project Settings > API > service_role. NUNCA no front.

# Calculadora RTC (componente offline da Receita, em container proprio)
RTC_CALC_URL=http://rtc-calc:8080   # dev fora do compose: http://localhost:8080
RTC_CALC_VERSION=            # saída do scripts/rtc-calc/import.*; tem que bater com rule_versions.calc_version

# Consulta de regime por CNPJ
CNPJ_API_URL=
CNPJ_API_KEY=

# DF-e (certificado A1 por tenant fica em integrations.secret_ref; aqui so a chave mestra)
# Chave-mestra que abre os certificados A1 cifrados pelo APP (envelope AES-256-GCM).
# TEM QUE SER IDÊNTICA à DFE_SECRET_KEY configurada nas variáveis do Lovable —
# o front cifra, o worker abre. Sem ela, ingest_dfe falha com "chave não corresponde".
DFE_SECRET_KEY=

WORKER_NAME=local-1
WORKER_KINDS=ingest_dfe,classify_chain,compute_taxes,project_cash
POLL_INTERVAL_MS=3000
LEASE_SECONDS=300
LOG_LEVEL=info

# Local padrão da operação quando a nota não informa destino (art. 11 LC 214/25)
RTC_DEFAULT_UF=GO
RTC_DEFAULT_MUNICIPIO=5208707
# Só em desenvolvimento, para rodar sem o container. Bloqueado em NODE_ENV=production.
# RTC_CALC_ALLOW_STUB=1

# Proxy HTTPS da Calculadora (Caddy) — para o app do Lovable chamar o motor
CALC_PROXY_DOMAIN=18-230-33-238.sslip.io
CALC_PROXY_KEY=            # gere com: openssl rand -hex 24
CALC_PROXY_EMAIL=diogo.admgo@gmail.com
